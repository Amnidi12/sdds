# ==============================================================================
# SDDT — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Required variables are marked [REQUIRED].
# ==============================================================================

# ---- [REQUIRED] App Secret (used to sign JWTs) ----
APP_SECRET=change-me-to-a-random-64-char-string

# ---- [REQUIRED] Database ----
# For Supabase: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For local dev: postgresql+asyncpg://sddt:sddt_dev_password@localhost:5432/sddt
DATABASE_URL=postgresql+asyncpg://sddt:sddt_dev_password@localhost:5432/sddt

# ---- App ----
ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# ---- Optional: Redis (rate limiting, caching). App works without it locally. ----
REDIS_URL=redis://localhost:6379/0

# ---- Optional: Email (SMTP). If unset, emails are logged to the console. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@smartdonation.local

# ---- Optional: AWS S3 for file storage ----
# For AWS S3:
#   S3_ENDPOINT= (leave empty for standard AWS S3)
#   S3_BUCKET=your-bucket-name
#   S3_ACCESS_KEY=AKIA...
#   S3_SECRET_KEY=your-secret
#   S3_REGION=ap-south-1
#
# For Supabase Storage (S3-compatible):
#   S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
#   S3_BUCKET=donations
#   S3_ACCESS_KEY=your-supabase-storage-access-key
#   S3_SECRET_KEY=your-supabase-storage-secret-key
#   S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
LOCAL_UPLOAD_DIR=./uploads

# ---- Optional: File upload limits ----
MAX_UPLOAD_SIZE_MB=10

# ---- Optional: Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: Supabase (if using Supabase as your backend) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Optional: Error monitoring ----
SENTRY_DSN=
